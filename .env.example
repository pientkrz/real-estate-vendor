# Public URL of this deployment (canonical links, sitemap, etc.).
# Test VPS: http://test.ixtnzfseqk.cfolks.pl (default if unset)
# Production: set to the real domain once one is chosen — placeholder for now.
SITE_URL=http://test.ixtnzfseqk.cfolks.pl

# Absolute path to the Otodom XML export file on the server.
# When set, this takes priority over OFFERS_XML_PATH and XML_COLLECTION_PATH.
# Example (production): /dostawa-ofert/otodom-pl/properties_otodom.xml
OTODOM_XML_PATH=

# Backward-compatible Otodom path alias. Prefer OTODOM_XML_PATH for new setup.
OFFERS_XML_PATH=

# Timestamped folder inside public/ that contains the Otodom XML export and photos.
# Used as a fallback when OFFERS_XML_PATH is not set (local development).
# Must match the folder name exactly, including URL-encoded characters.
# Example: 2026-05-23_13%3A07%3A04
XML_COLLECTION_PATH='2026-05-23_13%3A07%3A04'

# Directory containing blog Markdown files, relative to the project root.
# Defaults to ./src/content/blog if not set.
BLOG_CONTENT_PATH='./src/content/blog'

# Directory containing the privacy policy Markdown file, relative to the project root.
PRIVACY_POLICY_CONTENT_PATH='./src/content/privacy-policy'

# Path to the JSON file containing the list of broker agents.
AGENTS_FILE_PATH='./src/data/agents.json'

# URL prefix for listing photos.
# If not set, falls back to the local public/ folder (useful during development
# when you have the images checked out locally).
#
# For production set this to wherever the photos are hosted, e.g. a GitHub
# Releases asset URL or a path under the deployment's own SITE_URL.
PHOTO_BASE_URL=

# Individual provider feeds uploaded by FTP. They are optional until a provider
# sends its first file; all configured feeds are merged into the listing view.
# Production paths should point to the provider folders in /dostawa-ofert.
# NIERUCHOMOSCI_ONLINE_XML_PATH=/dostawa-ofert/nieruchomosci-online-pl/properties_noe2.xml
# OFERTY_NET_XML_PATH=/dostawa-ofert/oferty-net/oferty.xml
NIERUCHOMOSCI_ONLINE_XML_PATH=
OFERTY_NET_XML_PATH=

# Optional public URL prefixes for photos in each provider folder. When empty,
# PHOTO_BASE_URL is used for backwards compatibility.
OTODOM_PHOTO_BASE_URL=
NIERUCHOMOSCI_ONLINE_PHOTO_BASE_URL=
OFERTY_NET_PHOTO_BASE_URL=

# SMTP config for the two contact forms (src/server/mailer.js). Read via
# process.env at request time, never import.meta.env — this keeps the
# password out of the built JS bundle. If SMTP_HOST is left unset, the app
# falls back to a throwaway Ethereal test account so email sending can be
# built/verified without a real mail server.
SMTP_HOST=
SMTP_PORT=587
# false = STARTTLS on the port above (e.g. 587); true = implicit TLS (e.g. 465).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Address the app sends as. Must be one your SMTP server is authorized to
# send for, or receiving servers will spam-filter it.
MAIL_FROM=
# Where business notifications from both forms are delivered.
MAIL_TO=info@globalshome.com
