# Public URL of this deployment (canonical links, sitemap, etc.).
# Test VPS: http://test.ixtnzfseqk.cfolks.pl (default if unset)
# Production: set to the real domain once one is chosen — placeholder for now.
SITE_URL=http://test.ixtnzfseqk.cfolks.pl

# Directory containing blog Markdown files, relative to the project root.
# Defaults to ./src/content/blog if not set.
BLOG_CONTENT_PATH='./src/content/blog'

# Directory containing the privacy policy Markdown file, relative to the project root.
PRIVACY_POLICY_CONTENT_PATH='./src/content/privacy-policy'

# FTP inboxes. The Node ingestion command reads only ZIP files from these
# folders; the Astro application reads OFFER_STATE_PATH instead.
# VPS: /home/ixtnzfseqk/dostawa-ofert/{otodom-pl,nieruchomosci-online-pl,oferty-net}
OFFER_DELIVERY_ROOT=
OTODOM_DELIVERY_DIR=
NIERUCHOMOSCI_ONLINE_DELIVERY_DIR=
OFERTY_NET_DELIVERY_DIR=

# Private, durable runtime state. Keep it outside public_html.
# VPS examples:
# OFFER_STATE_PATH=/home/ixtnzfseqk/apps/new-global-s-home/data/offer-ingestion/offers-state.json
# OFFER_PHOTO_ROOT=/home/ixtnzfseqk/aktualne-zdjecia-ofert
OFFER_STATE_PATH=
OFFER_PHOTO_ROOT=
OFFER_PHOTO_PUBLIC_BASE_PATH=/offer-photos
OFFER_SETTLE_MINUTES=15
OFFER_RETAINED_FULL_CYCLES=1
OFFER_REJECTED_RETENTION_DAYS=3
OFFER_UNZIP_BIN=unzip

# SMTP config for the two contact forms (src/server/mailer.js). Read via
# process.env at request time, never import.meta.env — this keeps the
# password out of the built JS bundle. If SMTP_HOST is left unset, the app
# falls back to a throwaway Ethereal test account so email sending can be
# built/verified without a real mail server.
SMTP_HOST=
SMTP_PORT=587
# false = STARTTLS on the port above (e.g. 587); true = implicit TLS (e.g. 465).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Address the app sends as. Must be one your SMTP server is authorized to
# send for, or receiving servers will spam-filter it.
MAIL_FROM=
# Where business notifications from both forms are delivered.
MAIL_TO=info@globalshome.com
