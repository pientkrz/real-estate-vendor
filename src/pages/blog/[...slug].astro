---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import Footer from '../../components/Footer';
import RelatedCarousel from '../../components/RelatedCarousel';
import { formatBlogCategories } from '../../utils/blogCategories';
import { BLOG_TEMPLATE, loadRuntimeBlogPost, loadRuntimeBlogPosts } from '../../server/blogService.js';

export const prerender = false;

const slug = Array.isArray(Astro.params.slug) ? Astro.params.slug.join('/') : Astro.params.slug;
const entry = await loadRuntimeBlogPost(slug);
const allPosts = entry ? await loadRuntimeBlogPosts() : [];
const recentPosts = allPosts.filter((post) => !post.isInvalid);

if (!entry) Astro.response.status = 404;

---

<Layout title={entry ? `${entry.data.title} | Global S Journal` : 'Nie znaleziono artykułu | Global S Journal'} description={entry?.data.description || 'Artykuł nie istnieje lub nie jest dostępny.'}>
	<Navbar client:load />
	
	<main class="bg-bone pt-32">
		{!entry ? (
			<section class="max-w-7xl mx-auto px-6 md:px-12 py-48 text-center">
				<h1 class="text-5xl font-headline font-bold text-obsidian">Nie znaleziono artykułu</h1>
				<a class="mt-8 inline-block text-primary font-label uppercase tracking-widest" href={`${import.meta.env.BASE_URL}blog`}>Wróć do bloga</a>
			</section>
		) : (
		<>
		<!-- Editorial Hero -->
		<header class="max-w-7xl mx-auto px-6 md:px-12 pt-24 pb-12">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-end mb-16">
				<div>
					<span class="text-primary font-label text-xs tracking-[0.4em] uppercase mb-8 block">
						{formatBlogCategories(entry.data)}
					</span>
					<h1 class="text-5xl md:text-8xl font-headline font-bold leading-[0.9] tracking-tight text-obsidian">
						{entry.data.title}
					</h1>
				</div>
				
				<div class="flex gap-8 items-start border-l border-primary/20 pl-8">
					<p class="text-on-surface-variant font-body text-xl md:text-2xl leading-relaxed italic opacity-80">
						{entry.data.description}
					</p>
				</div>
			</div>

			{entry.data.thumbnail && (
				<div class="w-full aspect-[21/9] overflow-hidden bg-obsidian/5 mb-12">
					<img 
						src={entry.data.thumbnail} 
						alt={entry.data.title} 
						class="w-full h-full object-cover grayscale brightness-90 hover:grayscale-0 hover:brightness-100 transition-all duration-1000" 
					/>
				</div>
			)}
		</header>

		<!-- Article Layout -->
		<div class="max-w-7xl mx-auto px-6 md:px-12 grid grid-cols-1 lg:grid-cols-12 gap-16 pb-32">
			<!-- Sidebar Metadata -->
			<aside class="lg:col-span-3 space-y-12">
				<div class="sticky top-40">
					{!entry.isInvalid && <div class="mb-12">
						<span class="text-[10px] font-label uppercase tracking-widest text-primary mb-4 block">Published</span>
						<time class="text-xl font-headline font-bold" datetime={entry.data.pubDate.toISOString()}>
							{entry.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
						</time>
					</div>}

					{entry.data.author && (
						<div>
							<span class="text-[10px] font-label uppercase tracking-widest text-primary mb-4 block">Specialist</span>
							<span class="text-xl font-headline font-bold">{entry.data.author}</span>
						</div>
					)}

					<div class="pt-12 mt-12 border-t border-primary/10">
						<button class="text-[11px] font-label uppercase tracking-[0.3em] text-obsidian hover:text-primary transition-colors flex items-center gap-4">
							<span class="w-8 h-[1px] bg-current"></span>
							Share Piece
						</button>
					</div>
				</div>
			</aside>

			<!-- Content Area -->
			<article class="lg:col-span-9">
				{entry.isInvalid ? (
					<div class="max-w-3xl rounded-sm bg-surface-container-low p-8 md:p-12">
						<h2 class="font-headline text-3xl font-bold text-obsidian">Invalid blog</h2>
						<p class="mt-4 font-body text-on-surface-variant">Plik został odnaleziony, ale nie spełnia wymaganego formatu. Popraw wskazane pola; po zapisaniu poprawna wersja pojawi się przy następnym żądaniu strony.</p>
						<h3 class="mt-10 font-label text-xs uppercase tracking-widest text-primary">Informacje walidacyjne</h3>
						<ul class="mt-4 list-disc space-y-2 pl-5 font-body text-on-surface-variant">
							{entry.validationErrors.map((error) => <li>{error}</li>)}
						</ul>
						<h3 class="mt-10 font-label text-xs uppercase tracking-widest text-primary">Wymagany szablon pliku</h3>
						<pre class="mt-4 overflow-x-auto bg-obsidian p-5 text-sm leading-relaxed text-bone"><code>{BLOG_TEMPLATE}</code></pre>
					</div>
				) : (
					<div class="prose prose-stone prose-xl max-w-none prose-headings:font-headline prose-headings:font-bold prose-p:font-body prose-p:text-obsidian/80 prose-p:leading-loose prose-headings:tracking-tight prose-blockquote:font-serif prose-blockquote:italic prose-blockquote:text-primary prose-blockquote:border-primary" set:html={entry.html} />
				)}
			</article>
		</div>

		<!-- Related Content Carousel -->
		{!entry.isInvalid && <RelatedCarousel client:visible posts={recentPosts} currentPostId={entry.id} />}
		</>
		)}
	</main>
	
	<Footer />
</Layout>

<style is:global>
	@reference "../../index.css";
	
	/* High-end Editorial Typography overrides */
	.prose h2 {
		@apply font-serif text-4xl md:text-5xl mt-24 mb-12 italic font-normal text-obsidian;
	}
	
	.prose h3 {
		@apply font-headline text-2xl md:text-3xl mt-16 mb-8 text-obsidian font-bold;
	}

	.prose p {
		@apply mb-12;
	}

	.prose blockquote {
		@apply my-20 py-4 border-l-0 border-r-0 border-t border-b border-primary/20 text-center text-3xl md:text-4xl text-obsidian opacity-90 leading-tight not-italic;
	}

	.prose img {
		@apply my-24 shadow-none opacity-90 hover:opacity-100 transition-opacity duration-700;
	}
</style>
