---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import Footer from '../../components/Footer';
import AgentGrid from '../../components/AgentGrid';
import FeaturedProperties from '../../components/FeaturedProperties';
import PropertyMap from '../../components/PropertyMap';
import PropertyDetailsPanel from '../../components/property-details/PropertyDetailsPanel';
import PropertyInquiryForm from '../../components/PropertyInquiryForm';
import PropertyAgentCard from '../../components/PropertyAgentCard.astro';
import PropertyVideoEmbed from '../../components/PropertyVideoEmbed';
import {
    loadConfiguredNieruchomosciOnlineAgents,
    loadConfiguredPropertyAggregates,
} from '../../server/offerService.js';
import { toOfferDetailView, toOfferSummaryView } from '../../utils/propertyAggregate.js';
import { formatPrice } from '../../utils/formatPrice';
import { getYouTubeEmbedUrl } from '../../utils/videoUrl';
import { sanitizeOpisHtml, stripHtml } from '../../utils/sanitizeHtml';

export const prerender = false;

const _propertyAggregates = loadConfiguredPropertyAggregates();
const propertyAggregate = _propertyAggregates.find((candidate) => (
    candidate.lifecycle.isVisible
    && (candidate.id === Astro.params.id || Object.values(candidate.sourceRecords).some((record) => record.id === Astro.params.id))
));
if (!propertyAggregate) return Astro.redirect('/');

const offer = toOfferDetailView(propertyAggregate);
const _allOffers = _propertyAggregates
    .filter((candidate) => candidate.lifecycle.isVisible)
    .map(toOfferSummaryView);
const { params, location, price, currency } = offer;
const assignedAgent = offer.agent;

// Compute 3 most similar properties by price (60%) + area (40%) proximity
const _cp = price || 0;
const _ca = params?.powierzchnia || 0;
const relatedOffers = _allOffers
    .filter(o => o.id !== offer.id)
    .map(o => {
        const pd = _cp > 0 ? Math.abs((o.price || 0) - _cp) / _cp : 1;
        const ad = _ca > 0 ? Math.abs((o.params?.powierzchnia || 0) - _ca) / _ca : 1;
        return { offer: o, score: pd * 0.6 + ad * 0.4 };
    })
    .sort((a, b) => a.score - b.score)
    .slice(0, 3)
    .map(x => x.offer);

// Formatting helpers
const formattedPrice = formatPrice(price, currency);

const embedUrl = getYouTubeEmbedUrl(offer.videoUrl);
const safeOpis = sanitizeOpisHtml(params?.opis);
const opisExcerpt = stripHtml(params?.opis)?.substring(0, 160);

const mainImage = params?.zdjecie1 || '/assets/placeholder.svg';

// Dynamically collect all gallery photos (zdjecie2 onwards)
const galleryImages = [];
let _photoIdx = 2;
while (params?.[`zdjecie${_photoIdx}`]) {
    galleryImages.push(params[`zdjecie${_photoIdx}`]);
    _photoIdx++;
}

const city = params?.miasto || 'The Estate';
const fullAddress = [location?.city, location?.region, location?.country].filter(Boolean).join(', ');
const displayCount = (value) => Number(value) > 0 ? value : '—';
const displayArea = params?.powierzchnia ? `${params.powierzchnia} m²` : '—';

const agents = loadConfiguredNieruchomosciOnlineAgents();
---

<Layout title={`${city} | Global S Home`} description={opisExcerpt}>
    <Navbar client:load />
    
    <main class="min-h-screen bg-surface">
        <!-- Editorial Hero Section -->
        <section class="pt-32 pb-16">
            <div class="max-w-7xl mx-auto px-6 md:px-12">
                <div class="flex flex-col lg:flex-row lg:items-end justify-between mb-12 gap-8">
                    <div class="max-w-2xl animate-in fade-in slide-in-from-bottom-6 duration-1000">
                        <nav class="flex gap-4 mb-6 text-[10px] font-label uppercase tracking-[0.3em] text-primary">
                            <a href={import.meta.env.BASE_URL} class="hover:opacity-70 transition-opacity">Global S Home</a>
                            <span>/</span>
                            <a href={`${import.meta.env.BASE_URL}filter?type=${offer.typ}`} class="hover:opacity-70 transition-opacity">{offer.typ === 'sprzedaz' ? 'Sale' : 'Rent'}</a>
                        </nav>
                        <h1 class="text-6xl md:text-8xl font-headline font-bold text-on-surface leading-[1.05] tracking-tighter mb-4">
                            {city}
                        </h1>
                        <p class="text-xl text-on-surface-variant font-body">{fullAddress}</p>
                    </div>
                </div>

                <!-- Bento Gallery Overlay -->
                <div class="grid grid-cols-12 gap-1 lg:gap-3 rounded-xs overflow-hidden shadow-2xl">
                    <div class="col-span-12 lg:col-span-8 aspect-[16/10] lg:aspect-auto">
                        <img src={mainImage} alt={city} class="w-full h-full object-cover hover:scale-[1.02] transition-transform duration-1000" />
                    </div>
                    <div class="col-span-12 lg:col-span-4 grid grid-rows-2 gap-1 lg:gap-3">
                        {galleryImages.length > 0 ? (
                            galleryImages.slice(0, 2).map((img) => (
                                <div class="aspect-[16/9] lg:aspect-auto">
                                    <img src={img} alt={`${city} Gallery`} class="w-full h-full object-cover" />
                                </div>
                            ))
                        ) : (
                            <div class="bg-surface-container-high col-span-full h-full flex items-center justify-center text-outline/30 italic">
                                Additional imagery protected by NDA
                            </div>
                        )}
                    </div>
                </div>
            </div>
        </section>

        <!-- Dynamic Specs Bar -->
        <div class="sticky top-[var(--navbar-height)] z-40 bg-surface/80 backdrop-blur-xl border-y border-outline/10 h-20 flex items-center animate-in fade-in slide-in-from-top-4 duration-500 delay-500">
            <div class="max-w-7xl mx-auto px-6 md:px-12 w-full flex items-center justify-between text-on-surface">
                <div class="flex items-center gap-12 overflow-x-auto no-scrollbar">
                    <div>
                        <span class="block text-[9px] uppercase tracking-widest text-outline mb-1">Cena</span>
                        <span class="text-xl font-headline font-bold text-primary whitespace-nowrap">{formattedPrice}</span>
                    </div>
                    <div class="hidden sm:block w-px h-8 bg-outline/10"></div>
                    <div>
                        <span class="block text-[9px] uppercase tracking-widest text-outline mb-1">Powierzchnia</span>
                        <span class="flex items-center gap-2 text-xl font-headline font-bold whitespace-nowrap">
                            <span class="material-symbols-outlined text-primary">square_foot</span>{displayArea}
                        </span>
                    </div>
                    <div class="hidden sm:block w-px h-8 bg-outline/10"></div>
                    <div>
                        <span class="block text-[9px] uppercase tracking-widest text-outline mb-1">Pokoje</span>
                        <span class="flex items-center gap-2 text-xl font-headline font-bold">
                            <span class="material-symbols-outlined text-primary">meeting_room</span>{displayCount(params?.liczbapokoi)}
                        </span>
                    </div>
                    <div class="hidden sm:block w-px h-8 bg-outline/10"></div>
                    <div>
                        <span class="block text-[9px] uppercase tracking-widest text-outline mb-1">Sypialnie</span>
                        <span class="flex items-center gap-2 text-xl font-headline font-bold">
                            <span class="material-symbols-outlined text-primary">bedroom_parent</span>{displayCount(params?.liczbasypialni)}
                        </span>
                    </div>
                    <div class="hidden sm:block w-px h-8 bg-outline/10"></div>
                    <div>
                        <span class="block text-[9px] uppercase tracking-widest text-outline mb-1">Łazienki</span>
                        <span class="flex items-center gap-2 text-xl font-headline font-bold">
                            <span class="material-symbols-outlined text-primary">bathtub</span>{displayCount(params?.liczbalazienek)}
                        </span>
                    </div>
                </div>
                
            </div>
        </div>

        <!-- Main Content Area -->
        <section class="py-24">
            <div class="max-w-7xl mx-auto px-6 md:px-12">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-24">
                    <!-- Editorial Column -->
                    <div class="lg:col-span-8">
                        <div class="max-w-2xl">
                            <span class="text-primary font-label text-sm tracking-[0.3em] uppercase mb-6 block">Editorial Narrative</span>
                            <h2 class="text-4xl font-headline font-bold text-on-surface mb-12">Architecture as an Asset of the Soul</h2>
                            
                            <div class="prose prose-stone max-w-none text-lg text-on-surface-variant font-body leading-[1.8] space-y-8" set:html={safeOpis} />

                            <!-- Property-type-specific details panel (driven by ObjectName) -->
                            <PropertyDetailsPanel offer={offer} />
                        </div>
                    </div>

                    <!-- Sticky Collector Card -->
                    <aside class="lg:col-span-4 h-fit sticky top-48">
                        <div class="bg-surface-container-low border border-outline/5 p-10 rounded-sm shadow-xl">
                            <h3 class="text-2xl font-headline font-bold text-on-surface mb-2">Zapytaj o ofertę</h3>
                            <p class="text-sm text-on-surface-variant font-body mb-8">Otrzymaj kompletną dokumentację i analizę inwestycyjną w ciągu 24 godzin.</p>

                            <PropertyInquiryForm client:load propertyId={offer.id} propertyTitle={params?.tytul || city} propertyUrl={Astro.url.href} agentName={assignedAgent?.name} />

                            {assignedAgent && <PropertyAgentCard agent={assignedAgent} />}

                            <p class="mt-8 text-[10px] text-outline leading-relaxed text-center italic">
                                Oferta wyłączna Global S Home — <br/>Przesyłając formularz, akceptujesz naszą politykę prywatności.
                            </p>
                        </div>
                    </aside>
                </div>
            </div>
        </section>

        <!-- YouTube Video Tour (only rendered when a Video URL is present) -->
        {embedUrl && (
            <section class="py-24 border-t border-outline/5">
                <div class="max-w-7xl mx-auto px-6 md:px-12">
                    <div class="mb-12">
                        <span class="text-primary font-label text-sm tracking-[0.3em] uppercase mb-6 block">Property Tour</span>
                        <h2 class="text-5xl font-headline font-bold text-on-surface tracking-tighter">Visual Journey</h2>
                    </div>
                    <div class="aspect-video w-full rounded-sm overflow-hidden shadow-2xl">
                        <PropertyVideoEmbed client:load embedUrl={embedUrl} />
                    </div>
                </div>
            </section>
        )}

        <!-- Localization Section: The Enclave -->
        <section class="py-24 bg-surface-container-low/30 border-t border-outline/5">
            <div class="max-w-7xl mx-auto px-6 md:px-12">
                <div class="mb-16">
                    <span class="text-primary font-label text-sm tracking-[0.3em] uppercase mb-6 block">Geographical Context</span>
                    <h2 class="text-5xl font-headline font-bold text-on-surface tracking-tighter">The Enclave</h2>
                </div>
                
                <PropertyMap client:only="react" location={location} city={city} params={params} />
            </div>
        </section>

        <!-- Similar Properties -->
        {relatedOffers?.length > 0 && (
            <section class="py-24 border-t border-outline/5">
                <div class="max-w-7xl mx-auto px-6 md:px-12">
                    <FeaturedProperties properties={relatedOffers} title="Podobne nieruchomości" />
                </div>
            </section>
        )}

        <!-- Agent directory supplied by the Nieruchomosci-online.pl XML feed -->
        {agents.length > 0 ? <AgentGrid client:load agents={agents} /> : null}
    </main>

    <Footer />
</Layout>

<style>
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>
