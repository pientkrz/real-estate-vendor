---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import CollectionManager from '../components/CollectionManager';
import { loadConfiguredOffers } from '../server/offerService.js';
import { getRates } from '../server/rateService';

const allOffers = loadConfiguredOffers();
const { rates, timestamp, source } = getRates();
---

<Layout title="Global S Home | Premium Real Estate">
	<Navbar client:load />
	<CollectionManager
		client:load
		initialOffers={allOffers}
		initialRates={rates}
		initialRatesTimestamp={timestamp}
		initialRatesSource={source}
	/>
</Layout>
