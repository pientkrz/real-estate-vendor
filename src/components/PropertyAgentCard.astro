---
const { agent } = Astro.props;
const phoneHref = agent.phone?.replace(/[^+\d]/g, '');
const hasPhoto = Boolean(agent.image);
const agentName = agent.name || 'Global S Home';
const agentSrcSet = Array.isArray(agent.imageVariants)
  ? agent.imageVariants
    .filter((variant) => variant?.url && Number(variant.width) > 0)
    .sort((left, right) => Number(left.width) - Number(right.width))
    .map((variant) => `${variant.url} ${variant.width}w`)
    .join(', ')
  : undefined;
---

<section class="mt-5 bg-surface p-4" aria-label="Opiekun oferty">
  <span class="text-primary font-label text-[9px] tracking-[0.2em] uppercase mb-3 block">
    Twój opiekun oferty
  </span>
  <div class="flex gap-3">
    <img
      src={agent.image || '/assets/agent-placeholder.svg'}
      srcset={agentSrcSet}
      sizes="48px"
      alt={hasPhoto ? agentName : `Domyślne zdjęcie agenta: ${agentName}`}
      width="48"
      height="48"
      class="w-12 h-12 shrink-0 rounded-full object-cover bg-primary/10"
      loading="lazy"
    />
    <div class="min-w-0 flex-1">
      <h4 class="font-headline text-lg font-bold text-on-surface leading-tight">{agentName}</h4>
      <div class="mt-2 flex min-w-0 flex-wrap gap-x-4 gap-y-1 text-xs font-body">
        {agent.phone && (
          <a href={`tel:${phoneHref}`} class="flex items-center gap-1 text-on-surface hover:text-primary transition-colors">
            <span class="material-symbols-outlined text-sm text-primary" aria-hidden="true">call</span>
            <span>{agent.phone}</span>
          </a>
        )}
        {agent.email && (
          <a href={`mailto:${agent.email}`} class="flex min-w-0 items-center gap-1 text-on-surface hover:text-primary transition-colors" title={agent.email}>
            <span class="material-symbols-outlined shrink-0 text-sm text-primary" aria-hidden="true">mail</span>
            <span class="truncate">{agent.email}</span>
          </a>
        )}
      </div>
    </div>
  </div>
</section>
