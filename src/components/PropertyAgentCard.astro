---
const { agent } = Astro.props;
const phoneHref = agent.phone?.replace(/[^+\d]/g, '');
const hasPhoto = Boolean(agent.image);
const agentName = agent.name || 'Global S Home';
const agentSrcSet = Array.isArray(agent.imageVariants)
  ? agent.imageVariants
    .filter((variant) => variant?.url && Number(variant.width) > 0)
    .sort((left, right) => Number(left.width) - Number(right.width))
    .map((variant) => `${variant.url} ${variant.width}w`)
    .join(', ')
  : undefined;
---

<section class="mt-8 bg-surface p-6" aria-label="Opiekun oferty">
  <span class="text-primary font-label text-[10px] tracking-[0.22em] uppercase mb-4 block">
    Twój opiekun oferty
  </span>
  <div class="flex gap-4">
    <img
      src={agent.image || '/assets/agent-placeholder.svg'}
      srcset={agentSrcSet}
      sizes="56px"
      alt={hasPhoto ? agentName : `Domyślne zdjęcie agenta: ${agentName}`}
      width="56"
      height="56"
      class="w-14 h-14 shrink-0 rounded-full object-cover bg-primary/10"
      loading="lazy"
    />
    <div class="min-w-0 flex-1">
      <h4 class="font-headline text-xl font-bold text-on-surface leading-tight">{agentName}</h4>
      <p class="mt-1 text-xs font-label uppercase tracking-wider text-outline">Opiekun tej oferty</p>
    </div>
  </div>
  <div class="mt-5 flex flex-col items-start gap-2 text-sm font-body">
    {agent.phone && (
      <a href={`tel:${phoneHref}`} class="flex w-full items-center gap-1.5 text-left text-on-surface hover:text-primary transition-colors">
        <span class="material-symbols-outlined shrink-0 text-base text-primary" aria-hidden="true">call</span>
        <span class="min-w-0 whitespace-nowrap">{agent.phone}</span>
      </a>
    )}
    {agent.email && (
      <a href={`mailto:${agent.email}`} class="flex w-full min-w-0 items-center gap-1.5 text-left text-on-surface hover:text-primary transition-colors" title={agent.email}>
        <span class="material-symbols-outlined shrink-0 text-base text-primary" aria-hidden="true">mail</span>
        <span class="min-w-0 truncate">{agent.email}</span>
      </a>
    )}
  </div>
</section>
